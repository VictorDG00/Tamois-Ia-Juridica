<% content_for :title, "Chat — #{@analysis.filename} — Tamois" %>

<div class="chat-page-wrap">
  <div class="container chat-container">

    <div class="chat-page-header">
      <div class="page-title-group">
        <div class="t-label">Chat jurídico</div>
        <h1 style="font-family:var(--font-display);font-size:24px;font-weight:300;line-height:1.2"><%= @analysis.filename %></h1>
      </div>
      <div style="display:flex;gap:var(--s3)">
        <%= link_to "Ver análise", analysis_path(@analysis), class: "btn btn-secondary btn-sm" %>
        <%= link_to "← Histórico", analyses_path, class: "btn btn-ghost btn-sm" %>
      </div>
    </div>

    <div class="chat-layout-grid">

      <!-- Sidebar -->
      <div class="chat-sidebar">
        <div class="card" style="margin-bottom:var(--s4)">
          <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:var(--s4)">Resumo</div>
          <div style="display:flex;flex-direction:column;gap:var(--s3)">
            <div style="display:flex;justify-content:space-between;font-size:13px">
              <span style="color:var(--text-tertiary)">Ortografia</span>
              <span style="font-weight:500"><%= @analysis.orthography.length %></span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px">
              <span style="color:var(--text-tertiary)">Redação</span>
              <span style="font-weight:500"><%= @analysis.writing_suggestions.length %></span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:13px">
              <span style="color:var(--text-tertiary)">Insights</span>
              <span style="font-weight:500"><%= @analysis.legal_insights.length %></span>
            </div>
            <% high = @analysis.legal_insights.count { |i| i["risk_level"] == "high" } %>
            <% if high > 0 %>
              <div style="margin-top:var(--s2)">
                <span class="badge badge-risk"><%= high %> risco(s) alto(s)</span>
              </div>
            <% end %>
          </div>
        </div>

        <div class="card">
          <div style="font-family:var(--font-mono);font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:var(--text-tertiary);margin-bottom:var(--s4)">Perguntas sugeridas</div>
          <div style="display:flex;flex-direction:column;gap:var(--s2)">
            <% ["Quais são os maiores riscos deste contrato?", "Explique a cláusula de maior risco.", "Como posso melhorar a redação?"].each do |q| %>
              <button onclick="document.getElementById('chat-input').value = this.dataset.q; document.getElementById('chat-input').focus()"
                data-q="<%= q %>"
                style="text-align:left;background:var(--bg-surface);border:1px solid var(--border-subtle);border-radius:var(--r2);padding:var(--s2) var(--s3);font-size:12px;color:var(--text-secondary);cursor:pointer;transition:all var(--dur-fast)"
                onmouseover="this.style.borderColor='var(--border-accent)'"
                onmouseout="this.style.borderColor='var(--border-subtle)'">
                "<%= q %>"
              </button>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Chat card -->
      <div class="card chat-card">
        <div class="chat-messages" id="chat-messages">
          <% if @messages.empty? %>
            <div style="text-align:center;padding:var(--s8);color:var(--text-tertiary)">
              <div style="font-size:32px;margin-bottom:var(--s4)">💬</div>
              <div style="font-family:var(--font-display);font-size:20px;font-weight:300;margin-bottom:var(--s3)">Olá! Sou o Tamois.</div>
              <div style="font-size:14px">Faça perguntas sobre o documento <strong><%= @analysis.filename %></strong>.</div>
            </div>
          <% else %>
            <% @messages.each do |msg| %>
              <div class="chat-bubble chat-bubble-<%= msg.role %>">
                <div class="bubble-content<%= msg.role == 'assistant' ? ' markdown-body' : '' %>"><%= msg.role == 'assistant' ? markdown(msg.content) : simple_format(h(msg.content)) %></div>
                <div style="font-family:var(--font-mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-tertiary);margin-top:4px;padding:0 var(--s2)">
                  <%= msg.role == "user" ? "Você" : "Tamois" %> · <%= msg.created_at.strftime("%H:%M") %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>

        <div class="chat-composer">
          <%= form_with url: analysis_chat_path(@analysis), method: :post, id: "chat-form" do |f| %>
            <div style="display:flex;gap:var(--s3);align-items:flex-start">
              <%= f.text_area :message, id: "chat-input", class: "input",
                  placeholder: "Pergunte sobre o documento… (Enter envia · Shift+Enter nova linha)",
                  rows: 3, style: "resize:none;flex:4;min-width:0;overflow-y:hidden" %>
              <%= f.submit "Enviar", id: "chat-submit", class: "btn btn-primary",
                  style: "flex:1;min-width:0" %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  const msgs   = document.getElementById('chat-messages');
  const form   = document.getElementById('chat-form');
  const input  = document.getElementById('chat-input');
  const submit = document.getElementById('chat-submit');

  if (msgs) msgs.scrollTop = msgs.scrollHeight;

  // Fixa a altura do botão igual à altura inicial do textarea, e auto-cresce o textarea
  const initialInputHeight = input.scrollHeight;
  submit.style.height = initialInputHeight + 'px';

  input.addEventListener('input', function() {
    this.style.height = 'auto';
    this.style.height = Math.max(initialInputHeight, this.scrollHeight) + 'px';
  });

  function now() {
    return new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
  }

  function appendBubble(role, html) {
    const wrap = document.createElement('div');
    wrap.className = `chat-bubble chat-bubble-${role}`;
    wrap.innerHTML = `
      <div class="bubble-content${role === 'assistant' ? ' markdown-body' : ''}">${html}</div>
      <div style="font-family:var(--font-mono);font-size:9px;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-tertiary);margin-top:4px;padding:0 var(--s2)">
        ${role === 'user' ? 'Você' : 'Tamois'} · ${now()}
      </div>`;
    msgs.appendChild(wrap);
    msgs.scrollTop = msgs.scrollHeight;
    return wrap;
  }

  function sendMessage(e) {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;

    input.value = '';
    input.style.height = initialInputHeight + 'px';
    input.disabled = true;
    submit.disabled = true;
    submit.textContent = 'Enviando…';

    const safe = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>');
    appendBubble('user', safe);
    const loadingBubble = appendBubble('assistant', '<span class="chat-typing"><span></span><span></span><span></span></span>');

    const data = new FormData();
    data.append('message', text);
    data.append('authenticity_token', document.querySelector('input[name="authenticity_token"]').value);

    fetch(form.action, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } })
      .then(r => r.json())
      .then(data => {
        loadingBubble.querySelector('.bubble-content').innerHTML = data.html;
        msgs.scrollTop = msgs.scrollHeight;
        input.disabled = false;
        submit.disabled = false;
        submit.textContent = 'Enviar';
        input.focus();
      })
      .catch(() => {
        loadingBubble.querySelector('.bubble-content').textContent = 'Erro ao carregar resposta.';
        input.disabled = false;
        submit.disabled = false;
        submit.textContent = 'Enviar';
      });
  }

  form.addEventListener('submit', sendMessage);
  input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(e); }
  });
</script>
